# Пример настроек. Скопируйте файл в .env и подставьте свои значения.
# Все значения ниже вымышленные: не используйте их на боевом сервере.

# Режим отладки: True только на машине разработчика, на сервере — False.
DEBUG=True
# Длинная случайная строка (от 50 символов), у каждого окружения своя.
SECRET_KEY=replace-with-a-long-random-string-of-at-least-50-characters
ALLOWED_HOSTS=127.0.0.1,localhost
# Адрес сайта, который попадает в QR-коды и короткие ссылки.
SELFSTORAGE_DOMAIN=127.0.0.1:8000

# База данных: SQLite для разработки, PostgreSQL для сервера (USE_SQLITE=False).
USE_SQLITE=True
POSTGRES_DB=selfstorage
POSTGRES_USER=selfuser
POSTGRES_PASSWORD=replace-with-a-database-password
# В Docker Compose хост базы — имя сервиса: db.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Почта для писем восстановления пароля. В разработке письма печатаются в консоль,
# на сервере укажите SMTP-бэкенд и параметры вашего почтового сервиса.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SelfStorage <no-reply@example.com>

# HTTPS: включайте только когда сайт открывается по https (TLS настроен на nginx).
USE_HTTPS=False
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
